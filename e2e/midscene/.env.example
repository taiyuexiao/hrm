# Midscene 连接行内 LLM 网关所需的环境变量
# 使用前：cp .env.example .env 并填真实值

# 行内 LLM 网关（OpenAI 兼容协议）
OPENAI_BASE_URL=http://10.202.32.20:8180/lm/v2
OPENAI_API_KEY=填入网关Key

# 模型名（必须是多模态视觉模型，如 qwen-vl 系列；纯文本模型无法做 UI 定位）
MIDSCENE_MODEL_NAME=qwen-vl-max

# 测试账号（普通管理员即可）
E2E_USERNAME=e2e_test
E2E_PASSWORD=E2e@test123

# 被测系统地址（本地 dev 或测试环境）
E2E_BASE_URL=http://localhost:5173
E2E_API_URL=http://localhost:8080/api
